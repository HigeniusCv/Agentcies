--			*answers: flowScale
--	*group
--		*question: I was totally absorbed in what I was doing
--			*save: fm2
--			*answers: flowScale
--	*group
--		*question: My thoughts/actions ran smoothly
--			*save: fm3
--			*answers: flowScale
--	*group
--		*question: I didn't notice time passing
--			*save: fm4
--			*answers: flowScale
--
-- >> taskFlow = (fm1 + fm2 + fm3 + fm4) * 5
-- >> flowTotals = flowTotals + [taskFlow]
